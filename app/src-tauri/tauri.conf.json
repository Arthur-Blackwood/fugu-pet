{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fugu Pet",
  "version": "0.1.0",
  "identifier": "com.fugu.desktoppet",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Fugu Pet",
        "width": 280,
        "height": 240,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "acceptFirstMouse": true,
        "focus": false,
        "visible": false,
        "devtools": true,
        "dragDropEnabled": true
      },
      {
        "label": "panel",
        "title": "Fugu Pet",
        "url": "panel.html",
        "width": 340,
        "height": 460,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "dragDropEnabled": false,
        "acceptFirstMouse": true,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "bubble",
        "title": "Fugu Pet",
        "url": "bubble.html",
        "width": 250,
        "height": 64,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "focusable": false,
        "dragDropEnabled": false,
        "visibleOnAllWorkspaces": true
      },
      {
        "label": "play",
        "title": "Fugu Pet",
        "url": "play.html",
        "width": 800,
        "height": 600,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": false,
        "skipTaskbar": true,
        "visible": false,
        "focus": false,
        "acceptFirstMouse": true,
        "dragDropEnabled": false,
        "visibleOnAllWorkspaces": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}